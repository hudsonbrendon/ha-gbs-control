  "services": {
    "send_command": {
      "name": "Invia comando",
      "description": "Invia un comando grezzo di un singolo carattere a un dispositivo GBS Control.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "Il dispositivo GBS Control a cui inviare il comando."
        },
        "command": {
          "name": "Comando",
          "description": "Carattere di comando singolo, ad es. 7 (scanline) o f (peaking)."
        },
        "path": {
          "name": "Endpoint",
          "description": "uc = comando utente/web, sc = comando seriale di basso livello."
        }
      }
    },
    "set_slot": {
      "name": "Imposta slot attivo",
      "description": "Passa il dispositivo a uno slot salvato.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "Il dispositivo GBS Control a cui inviare il comando."
        },
        "slot": {
          "name": "Slot",
          "description": "Identificatore dello slot (un carattere) usato dal dispositivo, ad es. 0."
        }
      }
    },
    "save_slot": {
      "name": "Salva slot",
      "description": "Salva le impostazioni correnti in uno slot con un nome.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "Il dispositivo GBS Control a cui inviare il comando."
        },
        "index": {
          "name": "Indice",
          "description": "Indice dello slot (in base 0)."
        },
        "name": {
          "name": "Nome",
          "description": "Nome da memorizzare per lo slot."
        }
      }
    },
    "remove_slot": {
      "name": "Rimuovi slot attivo",
      "description": "Rimuove lo slot attualmente attivo.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "Il dispositivo GBS Control a cui inviare il comando."
        }
      }
    },
    "refresh": {
      "name": "Aggiorna",
      "description": "Ricarica gli slot salvati e chiede al dispositivo di stampare opzioni e registri colore.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "Il dispositivo GBS Control da aggiornare."
        }
      }
    }
