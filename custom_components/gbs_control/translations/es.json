  "services": {
    "send_command": {
      "name": "Enviar comando",
      "description": "Envía un comando bruto de un solo carácter a un dispositivo GBS Control.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "El dispositivo GBS Control al que enviar el comando."
        },
        "command": {
          "name": "Comando",
          "description": "Carácter único del comando, p. ej. 7 (líneas de escaneo) o f (realce)."
        },
        "path": {
          "name": "Endpoint",
          "description": "uc = comando de usuario/web, sc = comando serie de bajo nivel."
        }
      }
    },
    "set_slot": {
      "name": "Establecer ranura activa",
      "description": "Cambia el dispositivo a una ranura guardada.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "El dispositivo GBS Control al que enviar el comando."
        },
        "slot": {
          "name": "Ranura",
          "description": "Identificador de ranura (un carácter) que usa el dispositivo, p. ej. 0."
        }
      }
    },
    "save_slot": {
      "name": "Guardar ranura",
      "description": "Guarda la configuración actual en una ranura con un nombre.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "El dispositivo GBS Control al que enviar el comando."
        },
        "index": {
          "name": "Índice",
          "description": "Índice de ranura (base 0)."
        },
        "name": {
          "name": "Nombre",
          "description": "Nombre a guardar para la ranura."
        }
      }
    },
    "remove_slot": {
      "name": "Eliminar ranura activa",
      "description": "Elimina la ranura actualmente activa.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "El dispositivo GBS Control al que enviar el comando."
        }
      }
    },
    "refresh": {
      "name": "Actualizar",
      "description": "Recarga los slots guardados y pide al dispositivo que imprima sus opciones y registros de color.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "El dispositivo GBS Control a actualizar."
        }
      }
    }
