{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "GBS Control",
        "description": "Enter the hostname or IP of your GBS Control device.",
        "data": {
          "host": "Host"
        }
      },
      "zeroconf_confirm": {
        "title": "GBS Control",
        "description": "Do you want to add the GBS Control device at {name}?"
      },
      "reconfigure": {
        "title": "GBS Control",
        "description": "Update the hostname or IP of your GBS Control device.",
        "data": {
          "host": "Host"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the device."
    },
    "abort": {
      "already_configured": "This device is already configured.",
      "cannot_connect": "Failed to connect to the device.",
      "reconfigure_successful": "Re-configuration was successful."
    }
  },
  "services": {
    "send_command": {
      "name": "Send command",
      "description": "Send a raw single-character command to a GBS Control device.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The GBS Control device to send the command to."
        },
        "command": {
          "name": "Command",
          "description": "Single command character, e.g. 7 (scanlines) or f (peaking)."
        },
        "path": {
          "name": "Endpoint",
          "description": "uc = user/web command, sc = low-level serial command."
        }
      }
    },
    "set_slot": {
      "name": "Set active slot",
      "description": "Switch the device to a saved slot.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The GBS Control device to send the command to."
        },
        "slot": {
          "name": "Slot",
          "description": "Slot identifier (single character) as used by the device, e.g. 0."
        }
      }
    },
    "save_slot": {
      "name": "Save slot",
      "description": "Save the current settings to a slot with a name.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The GBS Control device to send the command to."
        },
        "index": {
          "name": "Index",
          "description": "Slot index (0-based)."
        },
        "name": {
          "name": "Name",
          "description": "Name to store for the slot."
        }
      }
    },
    "remove_slot": {
      "name": "Remove active slot",
      "description": "Remove the currently active slot.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The GBS Control device to send the command to."
        }
      }
    },
    "refresh": {
      "name": "Refresh",
      "description": "Reload the saved slots and ask the device to print its options and colour registers.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The GBS Control device to refresh."
        }
      }
    }
  },
