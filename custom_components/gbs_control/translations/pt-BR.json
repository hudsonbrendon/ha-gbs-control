{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "GBS Control",
        "description": "Informe o hostname ou IP do seu dispositivo GBS Control.",
        "data": {
          "host": "Host"
        }
      },
      "zeroconf_confirm": {
        "title": "GBS Control",
        "description": "Deseja adicionar o dispositivo GBS Control em {name}?"
      },
      "reconfigure": {
        "title": "GBS Control",
        "description": "Atualize o hostname ou IP do seu dispositivo GBS Control.",
        "data": {
          "host": "Host"
        }
      }
    },
    "error": {
      "cannot_connect": "Falha ao conectar ao dispositivo."
    },
    "abort": {
      "already_configured": "Este dispositivo já está configurado.",
      "cannot_connect": "Falha ao conectar ao dispositivo.",
      "reconfigure_successful": "Reconfiguração concluída com sucesso."
    }
  },
  "services": {
    "send_command": {
      "name": "Enviar comando",
      "description": "Envia um comando bruto de um caractere para um dispositivo GBS Control.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "O dispositivo GBS Control para onde enviar o comando."
        },
        "command": {
          "name": "Comando",
          "description": "Caractere único do comando, ex.: 7 (scanlines) ou f (peaking)."
        },
        "path": {
          "name": "Endpoint",
          "description": "uc = comando de usuário/web, sc = comando serial de baixo nível."
        }
      }
    },
    "set_slot": {
      "name": "Definir slot ativo",
      "description": "Muda o dispositivo para um slot salvo.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "O dispositivo GBS Control para onde enviar o comando."
        },
        "slot": {
          "name": "Slot",
          "description": "Identificador do slot (um caractere) usado pelo dispositivo, ex.: 0."
        }
      }
    },
    "save_slot": {
      "name": "Salvar slot",
      "description": "Salva as configurações atuais em um slot com um nome.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "O dispositivo GBS Control para onde enviar o comando."
        },
        "index": {
          "name": "Índice",
          "description": "Índice do slot (base 0)."
        },
        "name": {
          "name": "Nome",
          "description": "Nome a salvar para o slot."
        }
      }
    },
    "remove_slot": {
      "name": "Remover slot ativo",
      "description": "Remove o slot atualmente ativo.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "O dispositivo GBS Control para onde enviar o comando."
        }
      }
    },
    "refresh": {
      "name": "Atualizar",
      "description": "Recarrega os slots salvos e pede ao dispositivo para imprimir suas opções e registradores de cor.",
      "fields": {
        "device_id": {
          "name": "Dispositivo",
          "description": "O dispositivo GBS Control a atualizar."
        }
      }
    }
  },
